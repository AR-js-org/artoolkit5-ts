{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    // Vite's own ambient declarations, which include `declare module '*?url'`.
    // The examples import the WASM binary through that suffix and would
    // otherwise need a suppression at each import site.
    //
    // Naming anything here switches off the automatic inclusion of every other
    // `@types/*` package. `node` is deliberately not listed: nothing under
    // `src`, `test` or `examples` uses a Node global, and `vite.config.ts`,
    // which uses `node:path` and `__dirname`, gets them transitively from
    // vite's own `/// <reference types="node" />`. Add it here if that ever
    // stops being true.
    "types": ["vite/client"]
  },
  // Everything whose types are worth checking, not just what ships. `test/`,
  // `examples/` and this file's sibling `vite.config.ts` are compiled by vitest
  // and the dev server at runtime, which catches syntax and resolution errors
  // but no type errors — before this they were checked by nobody (#44).
  //
  // Emit is unaffected: `tsconfig.build.json` extends this and narrows `include`
  // back to `src/index.ts`, so widening here cannot reach `dist/`.
  "include": ["src", "test", "examples", "vite.config.ts"]
}
